# Where the Adinkra API is reachable from the browser.
REACT_APP_API_URL=http://localhost:3006/api

# A Google Maps JS API key. This one is public by design -- it ships in the page
# -- but restrict it to your own domains in the Google Cloud console, otherwise
# anyone can copy it out of the HTML and bill you for their own traffic.
REACT_APP_GOOGLE_MAPS_API_KEY=
