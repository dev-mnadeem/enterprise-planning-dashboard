{
  "name": "adinkra",
  "author": "adinkra",
  "licence": "MIT",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=v20.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "yarn rm:all && yarn install && yarn dev",
    "re:build": "yarn rm:all && yarn install && yarn build",
    "re:build-npm": "npm run rm:all && npm install && npm run build",
    "precommit": "npm run prettier && npm run lint:fix",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@faker-js/faker": "^8.1.0",
    "@iconify/react": "^4.1.1",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "^5.0.0-alpha.147",
    "@mui/material": "^5.14.12",
    "@react-google-maps/api": "^2.19.3",
    "@reduxjs/toolkit": "^2.2.3",
    "apexcharts": "^3.43.0",
    "axios": "^1.6.8",
    "date-fns": "^2.30.0",
    "formik": "^2.4.6",
    "history": "^5.3.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.1",
    "react-dom": "^18.2.0",
    "react-google-maps": "^9.4.5",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.47.0",
    "react-redux": "^9.1.1",
    "react-router-dom": "^6.16.0",
    "react-scripts": "^5.0.1",
    "react-select": "^5.8.0",
    "redux-persist": "^6.0.0",
    "simplebar-react": "^3.2.4",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "eslint": "^8.51.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^9.0.11",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.4.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
